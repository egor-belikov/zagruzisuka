# Лимит одного файла (~1 GiB) + см. YTDLP_LONG_VIDEO_* в worker (длинные — 360p).
YTDLP_MAX_FILESIZE_BYTES=1073741824
MAX_SIMULTANEOUS_DOWNLOADS=1
# Дольше 10 мин — качать в низком формате (см. downloader). Отключить: YTDLP_LONG_VIDEO_SECONDS=0
YTDLP_LONG_VIDEO_SECONDS=600
DOWNLOAD_PROGRESS_PULSE_SECONDS=180

# Bunkr CDN (prxp-b.cdn.cr) блокирует датацентровые IP. Residential SOCKS:
# BUNKR_CDN_PROXY=socks5h://user:pass@host:port
